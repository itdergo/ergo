# =============================================================================
# ERGO Contracts — production environment for cPanel
# Copy to the Node.js app's .env (or set the same keys in
# cPanel > Setup Node.js App > Environment variables).
#
# NEVER commit a real .env — only this template lives in git.
# =============================================================================

# ---- Runtime ----
NODE_ENV=production
PORT=5000

# ---- Database ----
# Create the database in cPanel > PostgreSQL Databases first. cPanel prefixes
# both the user and database with your account name, e.g. ergoco_ergo.
DATABASE_URL=postgresql://CPANEL_USER:DB_PASSWORD@localhost:5432/CPANEL_USER_ergo_contracts

# ---- CORS ----
# Comma-separated browser origins allowed to call the API. Must include the
# live site. (With the /api reverse proxy in .htaccess the browser sees a
# same-origin request, but the proxied Origin header still has to be allowed.)
CORS_ORIGINS=https://www.ergo.com.ph,https://ergo.com.ph

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
JWT_TTL=8h

# ---- Admin (seed only) ----
# Leave ADMIN_PASSWORD blank to have the seed generate a strong one and print it
# once. Set it explicitly if you need to know it up front.
ADMIN_EMAIL=admin@ergo.com.ph
ADMIN_PASSWORD=

# ---- Uploads ----
# NOTE: the code currently hardcodes `path.resolve(process.cwd(), "uploads")`
# in backend/src/routes/uploads.ts and ignores UPLOAD_DIR. Keep it here for
# parity with .env.example, but the effective location is <app CWD>/uploads —
# make sure that path survives redeploys (see infra/cpanel/README.md).
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ---- Redis (optional) ----
# cPanel shared hosting rarely provides Redis. Leave unset to disable caching
# and rate limiting — the backend runs fine without it.
# REDIS_URL=redis://127.0.0.1:6379
