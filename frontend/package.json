{
  "name": "@ergo/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run images:manifest && vite --config vite.config.js --host 0.0.0.0",
    "build": "npm run images:manifest && vite build --config vite.config.js && node scripts/gen-sitemap.mjs && node scripts/prerender.mjs",
    "images:manifest": "node scripts/gen-image-manifest.mjs",
    "images:webp": "bash scripts/gen-webp-variants.sh",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "prerender": "node scripts/prerender.mjs",
    "serve": "vite preview --config vite.config.js --host 0.0.0.0"
  },
  "devDependencies": {
    "@ergo/api-client-react": "*",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "jsdom": "^30.1.2",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "vite": "^7.3.2",
    "vitest": "^5.0.4",
    "wouter": "^3.3.5",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "vite-plugin-pwa": "^2.0.0"
  }
}
