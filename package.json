{
  "name": "ergo-contracts-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "backend",
    "database",
    "shared/*",
    "scripts"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:frontend\"",
    "dev:api": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build:shared && npm run build:database && npm run build:api && npm run build:frontend",
    "build:shared": "npm run build -w shared/api-zod && npm run build -w shared/api-client-react",
    "build:database": "npm run build -w database",
    "build:api": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "seed": "npm run seed -w scripts",
    "db:push": "npm run push -w database",
    "db:generate": "npm run generate -w database",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w frontend && npm run typecheck -w backend",
    "test": "npm run test:backend && npm run test:frontend && npm run test:e2e",
    "test:backend": "cd backend && npx vitest run",
    "test:frontend": "cd frontend && npx vitest run",
    "test:e2e": "cd frontend && npx playwright test",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "helmet": "^8.3.0",
    "prettier": "^3.4.2",
    "redis": "^6.3.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "framer-motion": "^14.1.0"
  }
}
