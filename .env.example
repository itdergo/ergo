# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/ergo_contracts

# ---- Server ----
PORT=5000
NODE_ENV=development
BASE_PATH=/

# ---- Frontend ----
VITE_API_URL=http://localhost:5000/api

# ---- Redis (optional — app runs without it) ----
# REDIS_URL=redis://localhost:6379

# ---- Auth ----
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=8h

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,https://ergo.com.ph

# ---- Admin (seed only) ----
# Leave ADMIN_PASSWORD empty to have the seed generate a strong password and print it once.
ADMIN_EMAIL=admin@ergo.com.ph
ADMIN_PASSWORD=

# ---- File Uploads ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

